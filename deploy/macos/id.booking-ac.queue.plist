<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Queue worker (pengganti Supervisor di macOS). Salin ke ~/Library/LaunchAgents/ lalu:
     launchctl load -w ~/Library/LaunchAgents/id.booking-ac.queue.plist -->
<plist version="1.0">
<dict>
    <key>Label</key><string>id.booking-ac.queue</string>
    <key>WorkingDirectory</key><string>/Users/USER/booking-ac</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/php</string>
        <string>artisan</string>
        <string>queue:work</string>
        <string>--sleep=3</string>
        <string>--tries=3</string>
        <string>--max-time=3600</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/USER/booking-ac/storage/logs/queue.log</string>
    <key>StandardErrorPath</key><string>/Users/USER/booking-ac/storage/logs/queue.log</string>
</dict>
</plist>
