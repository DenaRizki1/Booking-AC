# Booking AC — contoh .env PRODUKSI (komputer sendiri di balik Cloudflare Tunnel).
# Salin ke .env di server, isi nilai bertanda <...>, lalu: php artisan key:generate
# JANGAN commit file .env yang berisi kredensial.

APP_NAME="Booking AC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking_ac
DB_USERNAME=booking_ac
DB_PASSWORD=<password-kuat>
# Lokasi mysqldump untuk backup harian (macOS Homebrew; Linux: /usr/bin/mysqldump)
DB_DUMP_BINARY=/opt/homebrew/bin/mysqldump

# Cookie hanya lewat HTTPS (HTTPS diterminasi Cloudflare)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email (F9). Isi SMTP sungguhan, mis. Gmail App Password / Brevo / Mailgun.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="<noreply@domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Google OAuth produksi — tambahkan redirect URI ini di Google Cloud Console:
#   https://<domain-anda>/auth/google/callback
GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
